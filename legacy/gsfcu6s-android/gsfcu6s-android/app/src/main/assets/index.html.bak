<!DOCTYPE html>
<html lang="en">
<head>
  <!--Add this in <head> -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">

<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>GSFCU 6S Monitor — Campus Compliance</title>
<link href="https://fonts.googleapis.com/css2?family=EB+Garamond:wght@400;500;600;700;800&family=Nunito+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
<style>
/* ══════════════════════════════════════════
   GSFCU BRAND TOKENS
   Primary  : Maroon  #8C1B2F  (deep university red)
   Secondary: Gold    #C4933F  (warm academic gold)
   Surface  : Cream   #FBF7F2  (warm off-white)
   Dark     : #1C0A0E (very dark maroon-black)
══════════════════════════════════════════ */
:root {
  --maroon:      #8C1B2F;
  --maroon2:     #6E1424;
  --maroon3:     #4D0D19;
  --maroon-light:#B02640;
  --maroon-dim:  rgba(140,27,47,0.10);
  --maroon-dim2: rgba(140,27,47,0.06);
  --gold:        #C4933F;
  --gold2:       #A87830;
  --gold-light:  #E2B96A;
  --gold-dim:    rgba(196,147,63,0.14);
  --cream:       #FBF7F2;
  --cream2:      #F5EFE6;
  --cream3:      #EDE4D6;
  --white:       #FFFFFF;
  --dark:        #1C0A0E;
  --dark2:       #2E1018;
  --slate:       #4A2030;
  --muted:       #7A4050;
  --border:      rgba(140,27,47,0.12);
  --border2:     rgba(140,27,47,0.22);
  --shadow:      rgba(28,10,14,0.12);
  --shadow2:     rgba(28,10,14,0.20);
  /* status */
  --green:       #1A8C4E;
  --green-dim:   rgba(26,140,78,0.12);
  --yellow:      #B07D10;
  --yellow-dim:  rgba(176,125,16,0.12);
  --red:         #C0182A;
  --red-dim:     rgba(192,24,42,0.12);
  --radius:      14px;
  --radius-sm:   9px;
}

* { margin:0; padding:0; box-sizing:border-box; }
html { scroll-behavior:smooth; }
body {
  font-family: 'Nunito Sans', sans-serif;
  background: var(--cream);
  color: var(--dark);
  min-height: 100vh;
  font-size: 14px;
}

::-webkit-scrollbar { width:6px; height:6px; }
::-webkit-scrollbar-track { background: var(--cream2); }
::-webkit-scrollbar-thumb { background: var(--maroon-dim2); border-radius:99px; }
::-webkit-scrollbar-thumb:hover { background: var(--maroon-dim); }

/* ══ SCREENS ══ */
.screen { display:none; min-height:100vh; flex-direction:column; }
.screen.active { display:flex; }

/* ════════════════════════════════════════
   LOGIN SCREEN
════════════════════════════════════════ */
#loginScreen {
  background-image: url('data:image/jpeg;base64,');
  background-position: flex;
  background-size: cover;       /* fills the full screen */
  background-position: center;  /* keeps it centered */
  background-repeat: no-repeat;
}

/* Decorative background pattern */
#loginScreen::before {
  content: '';
  position: absolute; inset:0;
  background-image:
    radial-gradient(ellipse 80% 60% at 20% 20%, rgba(196,147,63,0.12) 0%, transparent 60%),
    radial-gradient(ellipse 60% 80% at 80% 80%, rgba(140,27,47,0.3) 0%, transparent 60%);
}
.login-pattern {
  position: absolute; inset:0;
  background-image: repeating-linear-gradient(
    45deg,
    rgba(196,147,63,0.04) 0px,
    rgba(196,147,63,0.04) 1px,
    transparent 1px,
    transparent 40px
  );
}

.login-outer {
  margin: auto;
  position: relative; z-index:2;
  display: flex;
  gap: 0;
  width: 900px;
  max-width: 98vw;
  border-radius: 24px;
  overflow: hidden;
  box-shadow: 0 40px 100px rgba(0,0,0,0.55), 0 0 0 1px rgba(196,147,63,0.2);
  animation: fadeUp .65s cubic-bezier(.16,1,.3,1) both;
}
@keyframes fadeUp { from{opacity:0;transform:translateY(30px);} to{opacity:1;transform:translateY(0);} }

.login-left {
  width: 380px;
  flex-shrink:0;
  background: var(--white);
  padding: 52px 44px;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  position: relative;
  overflow: hidden;
}

/* Background image at 40% opacity — does NOT affect text/content */
.login-left .bg-image-layer {
  position: absolute;
  top: 0; left: 0;
  width: 100%; height: 100%;
  background-image: url('data:image/webp;base64,'); /* 👈 REPLACE with your image path */
  background-size: cover;
  background-position: center;
  opacity: 0.4;
  z-index: 0;
}

.login-left::after {
  content:'';
  position:absolute; bottom:-80px; right:-80px;
  width:260px; height:260px; border-radius:50%;
  border: 2px solid rgba(196,147,63,0.2);
  z-index: 1;
}
.login-left::before {
  content:'';
  position:absolute; top:-60px; left:-60px;
  width:200px; height:200px; border-radius:50%;
  border: 2px solid rgba(196,147,63,0.12);
  z-index: 1;
}

.ll-logo {
  display:flex; align-items:center; gap:14px; position:relative; z-index:1;
}
.ll-logo-icon {
  width:56px; height:56px;
  background: linear-gradient(135deg, var(--gold), var(--gold2));
  border-radius:14px;
  display:flex; align-items:center; justify-content:center;
  box-shadow: 0 8px 24px rgba(0,0,0,0.3);
  flex-shrink:0;
}

.ll-logo-text h1 {
  font-family: 'EB Garamond', serif;
  font-size: 20px; font-weight: 700;
  color: var(--maroon); line-height:1.2;
}
.ll-logo-text p { font-size:11px; color: var(--muted); margin-top:2px; }

.ll-body { position:relative; z-index:1; }
.ll-body h2 {
  font-family: 'EB Garamond', serif;
  font-size: 34px; font-weight: 700;
  color: var(--maroon); line-height:1.2; margin-bottom:12px;
}
.ll-body h2 span { color: var(--gold2); }
.ll-body p { font-size:13px; color:var(--muted); line-height:1.7; }

.ll-footer { position:relative; z-index:1; }
.ll-pills { display:flex; flex-wrap:wrap; gap:8px; margin-top:12px; }
.ll-pill {
  padding:5px 12px; border-radius:99px;
  background:rgba(140,27,47,0.08);
  border:1px solid rgba(140,27,47,0.2);
  color:var(--maroon); font-size:11px; font-weight:600;
}
.ll-footer p { color:var(--muted); font-size:11px; margin-bottom:8px; }

.login-right {
  flex:1;
  background: var(--white);
  padding: 52px 48px;
  display: flex;
  flex-direction: column;
  justify-content: center;
}
.login-right .lr-title {
  font-family: 'EB Garamond', serif;
  font-size: 26px; font-weight: 700;
  color: var(--maroon); margin-bottom:6px;
}
.login-right .lr-sub { color:var(--muted); font-size:13px; margin-bottom:32px; }

.lf { margin-bottom:20px; }
.lf label { display:block; font-size:11px; font-weight:800; color:var(--slate); letter-spacing:.8px; text-transform:uppercase; margin-bottom:8px; }
.lf input {
  width:100%; padding:13px 16px;
  border:1.5px solid var(--cream3);
  border-radius:var(--radius-sm);
  background:var(--cream);
  color:var(--dark); font-family:'Nunito Sans',sans-serif; font-size:14px;
  outline:none; transition:.2s;
}
.lf input:focus { border-color:var(--maroon); background:var(--white); box-shadow:0 0 0 3px rgba(140,27,47,0.08); }
.lf input::placeholder { color:var(--muted); opacity:.5; }

.btn-login {
  width:100%; padding:14px;
  background: linear-gradient(135deg, var(--maroon), var(--maroon2));
  border:none; border-radius:var(--radius-sm);
  color:var(--white); font-family:'Nunito Sans',sans-serif;
  font-size:15px; font-weight:700; cursor:pointer;
  box-shadow: 0 6px 24px rgba(140,27,47,0.35);
  transition: transform .18s, box-shadow .18s;
  letter-spacing:.3px;
}
.btn-login:hover { transform:translateY(-2px); box-shadow:0 10px 32px rgba(140,27,47,0.45); }
.login-err { color:var(--red); font-size:12px; font-weight:600; margin-bottom:12px; min-height:16px; }

@media(max-width:760px) {
  .login-left { display:none; }
  .login-right { padding:36px 28px; }
}

/* ════════════════════════════════════════
   SIDEBAR LAYOUT
════════════════════════════════════════ */
.app-layout { display:flex; min-height:100vh; flex:1; }

.sidebar {
  width: 252px; flex-shrink:0;
  background: var(--maroon3);
  display: flex; flex-direction:column;
  position: sticky; top:0; height:100vh; overflow-y:auto;
}

.sb-header {
  padding: 24px 20px;
  background: linear-gradient(160deg, var(--maroon2), var(--maroon3));
  border-bottom: 1px solid rgba(196,147,63,0.18);
}
.sb-logo-row { display:flex; align-items:center; gap:12px; margin-bottom:16px; }
.sb-icon {
  width:44px; height:44px;
  background:linear-gradient(135deg,var(--gold),var(--gold2));
  border-radius:12px; display:flex; align-items:center; justify-content:center;
  flex-shrink:0;
  box-shadow:0 4px 14px rgba(0,0,0,0.3);
}
.sb-brand h1 { font-family:'EB Garamond',serif; font-size:15px; font-weight:700; color:var(--white); line-height:1.25; }
.sb-brand p { font-size:10px; color:rgba(255,255,255,0.45); margin-top:2px; }

.sb-divider { height:1px; background:rgba(196,147,63,0.2); margin:4px 0 16px; }

.sb-section-label {
  font-size:9.5px; font-weight:800; letter-spacing:1.2px;
  text-transform:uppercase; color:rgba(196,147,63,0.6);
  padding:0 20px; margin-bottom:6px; margin-top:16px;
}

.sb-nav {
  display:flex; align-items:center; gap:11px;
  padding:10px 20px; cursor:pointer;
  color:rgba(255,255,255,0.55); font-size:13px; font-weight:600;
  border-left:3px solid transparent;
  transition:.2s;
}
.sb-nav:hover { background:rgba(196,147,63,0.1); color:rgba(255,255,255,0.85); }
.sb-nav.active {
  background:rgba(196,147,63,0.15);
  border-left-color:var(--gold);
  color:var(--gold-light);
}
.sb-nav .ni { font-size:15px; width:20px; text-align:center; flex-shrink:0; }

/* Zone pills in sidebar */
.sb-zone-pill-btn:hover {
  background: rgba(196,147,63,0.18) !important;
  border-radius: 8px;
  padding-right: 8px !important;
}
.sb-zone-pill {
  display:flex; align-items:center; gap:9px;
  padding:7px 20px; font-size:11.5px; font-weight:600;
  color:rgba(255,255,255,0.55);
}
.sb-zone-pill .zpd { width:8px; height:8px; border-radius:50%; flex-shrink:0; }

.sb-bottom {
  margin-top:auto;
  padding:20px;
  border-top:1px solid rgba(196,147,63,0.15);
}
.sb-user { display:flex; align-items:center; gap:11px; margin-bottom:14px; }
.sb-avatar {
  width:38px; height:38px; border-radius:50%;
  background:linear-gradient(135deg,var(--maroon),var(--maroon2));
  border:2px solid rgba(196,147,63,0.3);
  display:flex; align-items:center; justify-content:center;
  font-size:16px; flex-shrink:0;
}
.sb-uname { font-size:13px; font-weight:700; color:rgba(255,255,255,0.85); }
.sb-urole { font-size:10.5px; color:rgba(255,255,255,0.4); margin-top:2px; }
.btn-logout {
  width:100%; padding:9px;
  border:1px solid rgba(196,147,63,0.25);
  border-radius:var(--radius-sm); background:transparent;
  color:rgba(255,255,255,0.5); font-family:'Nunito Sans',sans-serif;
  font-size:12.5px; font-weight:600; cursor:pointer; transition:.2s;
}
.btn-logout:hover { background:rgba(192,24,42,0.2); border-color:rgba(192,24,42,0.5); color:rgba(255,150,150,0.9); }

/* ════════════════════════════════════════
   MAIN CONTENT
════════════════════════════════════════ */
.main-area { flex:1; overflow-y:auto; background:var(--cream); }

/* Top bar */
.top-bar {
  background:var(--white);
  border-bottom:1px solid var(--border);
  padding:0 36px;
  height:60px;
  display:flex; align-items:center; justify-content:space-between;
  position:sticky; top:0; z-index:50;
  box-shadow:0 2px 8px var(--shadow);
}
.tb-breadcrumb { font-size:13px; color:var(--muted); font-weight:500; }
.tb-breadcrumb strong { color:var(--maroon); font-weight:700; }
.tb-right { display:flex; align-items:center; gap:16px; }
.tb-badge {
  padding:4px 14px; border-radius:99px;
  font-size:11px; font-weight:800; letter-spacing:.4px; text-transform:uppercase;
}
.tb-l1 { background:rgba(26,140,78,0.12); color:var(--green); }
.tb-l2 { background:rgba(140,27,47,0.1); color:var(--maroon); }
.tb-l3 { background:rgba(196,147,63,0.15); color:var(--gold2); }
.tb-l4 { background:var(--maroon); color:var(--white); }

/* Page wrap */
.pg { padding:32px 36px; max-width:1160px; animation:fadeUp .35s cubic-bezier(.16,1,.3,1) both; }

/* Page header */
.pg-header { margin-bottom:28px; }
.pg-eyebrow {
  display:inline-flex; align-items:center; gap:8px;
  background:var(--maroon-dim); border:1px solid var(--border);
  border-radius:99px; padding:4px 14px;
  font-size:11px; font-weight:700; letter-spacing:.5px; text-transform:uppercase;
  color:var(--maroon); margin-bottom:10px;
}
.pg-eyebrow .edot { width:6px; height:6px; border-radius:50%; background:var(--gold); }
.pg-header h2 {
  font-family:'EB Garamond',serif;
  font-size:32px; font-weight:700; color:var(--maroon3);
  line-height:1.1; margin-bottom:6px;
}
.pg-header p { color:var(--muted); font-size:14px; line-height:1.6; }

/* ════ CARD ════ */
.card {
  background:var(--white);
  border:1px solid var(--border);
  border-radius:var(--radius);
  padding:26px;
  margin-bottom:20px;
  box-shadow:0 2px 10px var(--shadow);
  transition:box-shadow .2s, border-color .2s;
}
.card:hover { box-shadow:0 4px 20px var(--shadow2); border-color:var(--border2); }

.card-hdr { display:flex; justify-content:space-between; align-items:center; margin-bottom:20px; }
.card-title {
  font-family:'EB Garamond',serif;
  font-size:18px; font-weight:700; color:var(--maroon);
  display:flex; align-items:center; gap:10px;
}
.card-icon {
  width:34px; height:34px; border-radius:9px;
  display:flex; align-items:center; justify-content:center;
  font-size:16px; flex-shrink:0;
}
.ci-maroon { background:var(--maroon-dim); }
.ci-gold { background:var(--gold-dim); }
.ci-green { background:var(--green-dim); }
.ci-red { background:var(--red-dim); }

/* ════ GRIDS ════ */
.grid-2 { display:grid; grid-template-columns:1fr 1fr; gap:20px; }
.grid-3 { display:grid; grid-template-columns:1fr 1fr 1fr; gap:16px; }
.grid-4 { display:grid; grid-template-columns:repeat(4,1fr); gap:16px; }
@media(max-width:960px){ .grid-2,.grid-3,.grid-4{grid-template-columns:1fr;} .pg{padding:20px 16px;} }

/* ════ STAT CARDS ════ */
.sc {
  background:var(--white); border:1px solid var(--border);
  border-radius:var(--radius); padding:22px 24px;
  position:relative; overflow:hidden;
  box-shadow:0 2px 8px var(--shadow);
  transition:.2s;
}
.sc:hover { transform:translateY(-2px); box-shadow:0 6px 20px var(--shadow2); }
.sc::after {
  content:''; position:absolute; bottom:0; right:0;
  width:80px; height:80px; border-radius:50%;
  transform:translate(25px,25px);
  opacity:.07;
}
.sc-maroon::after { background:var(--maroon); }
.sc-gold::after { background:var(--gold); }
.sc-green::after { background:var(--green); }
.sc-red::after { background:var(--red); }

.sc-top { display:flex; justify-content:space-between; align-items:flex-start; margin-bottom:16px; }
.sc-ico { width:44px; height:44px; border-radius:12px; display:flex; align-items:center; justify-content:center; font-size:20px; }
.sc-maroon .sc-ico { background:var(--maroon-dim); }
.sc-gold .sc-ico { background:var(--gold-dim); }
.sc-green .sc-ico { background:var(--green-dim); }
.sc-red .sc-ico { background:var(--red-dim); }

.sc-num {
  font-family:'EB Garamond',serif;
  font-size:44px; font-weight:800; line-height:1;
}
.sc-maroon .sc-num { color:var(--maroon); }
.sc-gold .sc-num { color:var(--gold2); }
.sc-green .sc-num { color:var(--green); }
.sc-red .sc-num { color:var(--red); }
.sc-lbl { font-size:12px; color:var(--muted); font-weight:600; margin-top:4px; }

/* ════ STATUS BADGES ════ */
.bdg {
  display:inline-flex; align-items:center; gap:6px;
  padding:4px 12px; border-radius:99px;
  font-size:11px; font-weight:700; letter-spacing:.3px;
}
.bdg-g { background:var(--green-dim); color:var(--green); border:1px solid rgba(26,140,78,0.2); }
.bdg-y { background:var(--yellow-dim); color:var(--yellow); border:1px solid rgba(176,125,16,0.2); }
.bdg-r { background:var(--red-dim); color:var(--red); border:1px solid rgba(192,24,42,0.2); }
.sdot { width:6px; height:6px; border-radius:50%; flex-shrink:0; animation:pulse 2.5s ease-in-out infinite; }
@keyframes pulse{0%,100%{opacity:1;}50%{opacity:.5;}}
.sdg { background:var(--green); } .sdy { background:var(--yellow); } .sdr { background:var(--red); }

/* ════ FORMS ════ */
.fg { margin-bottom:18px; }
.fg label { display:block; font-size:11px; font-weight:800; color:var(--slate); letter-spacing:.8px; text-transform:uppercase; margin-bottom:8px; }
.fg input, .fg select, .fg textarea {
  width:100%; padding:12px 14px;
  border:1.5px solid var(--cream3); border-radius:var(--radius-sm);
  background:var(--cream); color:var(--dark);
  font-family:'Nunito Sans',sans-serif; font-size:14px; outline:none; transition:.2s;
}
.fg input:focus, .fg select:focus, .fg textarea:focus {
  border-color:var(--maroon); background:var(--white);
  box-shadow:0 0 0 3px rgba(140,27,47,0.08);
}
.fg input::placeholder, .fg textarea::placeholder { color:var(--muted); opacity:.55; }
.fg select { color:var(--dark); cursor:pointer; }
.fg select option { background:var(--white); color:var(--dark); }
.fg textarea { resize:vertical; min-height:96px; }

.btn-p {
  padding:12px 24px; border:none; border-radius:var(--radius-sm);
  background:linear-gradient(135deg,var(--maroon),var(--maroon2));
  color:var(--white); font-family:'Nunito Sans',sans-serif;
  font-weight:700; font-size:14px; cursor:pointer;
  box-shadow:0 4px 16px rgba(140,27,47,0.3); transition:.2s;
  letter-spacing:.2px;
}
.btn-p:hover { transform:translateY(-1px); box-shadow:0 7px 22px rgba(140,27,47,0.4); }
.btn-p:active { transform:translateY(0); }

.btn-gold {
  padding:7px 16px; border-radius:8px;
  background:linear-gradient(135deg,var(--gold),var(--gold2));
  border:none; color:var(--white);
  font-family:'Nunito Sans',sans-serif; font-size:12px; font-weight:700;
  cursor:pointer; transition:.2s;
  box-shadow:0 3px 10px rgba(196,147,63,0.3);
}
.btn-gold:hover { transform:translateY(-1px); box-shadow:0 5px 14px rgba(196,147,63,0.4); }

/* ════ TABLE ════ */
.tbl { width:100%; border-collapse:collapse; font-size:13px; }
.tbl thead { background:var(--cream); }
.tbl th { text-align:left; padding:10px 16px; font-size:10.5px; font-weight:800; letter-spacing:.6px; text-transform:uppercase; color:var(--muted); border-bottom:2px solid var(--cream3); }
.tbl td { padding:13px 16px; border-bottom:1px solid var(--cream2); color:var(--slate); vertical-align:middle; }
.tbl tr:last-child td { border-bottom:none; }
.tbl tbody tr:hover td { background:var(--maroon-dim2); }

/* ════ COMPLAINT ITEMS ════ */
.ci { padding:16px 18px; border:1px solid var(--border); border-radius:var(--radius-sm); margin-bottom:10px; background:var(--cream); transition:.2s; }
.ci:hover { border-color:var(--border2); background:var(--white); }
.ci-top { display:flex; justify-content:space-between; align-items:center; margin-bottom:8px; }
.ci-ztag { font-size:11px; font-weight:700; color:var(--maroon); background:var(--maroon-dim); padding:3px 10px; border-radius:99px; border:1px solid var(--border); }
.ci-desc { color:var(--slate); font-size:13px; line-height:1.65; }
.ci-meta { font-size:11px; color:var(--muted); margin-top:8px; }

/* ════ CHECKLIST ════ */
.cl-item { display:flex; align-items:center; gap:14px; padding:13px 16px; border:1px solid var(--border); border-radius:var(--radius-sm); margin-bottom:8px; background:var(--cream); cursor:pointer; transition:.2s; }
.cl-item:hover { border-color:var(--border2); background:var(--white); }
.cl-item.checked { border-color:rgba(26,140,78,0.35); background:rgba(26,140,78,0.05); }
.cl-item input[type=checkbox] { width:17px; height:17px; accent-color:var(--green); cursor:pointer; flex-shrink:0; }
.cl-item label { font-size:13.5px; color:var(--slate); cursor:pointer; flex:1; transition:.2s; }
.cl-item.checked label { color:var(--green); }
.cl-time { font-size:11px; color:var(--gold2); font-weight:700; }

/* ════ UPLOAD ════ */
.upload-zone { border:2px dashed var(--cream3); border-radius:var(--radius); padding:30px 20px; text-align:center; background:var(--cream); cursor:pointer; transition:.25s; }
.upload-zone:hover { border-color:var(--maroon); background:var(--maroon-dim2); }
.up-emoji { font-size:34px; margin-bottom:10px; }
.up-text { font-size:13px; color:var(--muted); }
.up-hint { font-size:11px; color:var(--muted); opacity:.6; margin-top:4px; }
.photo-preview { display:flex; gap:10px; flex-wrap:wrap; margin-top:12px; }
.photo-thumb { width:72px; height:72px; border-radius:10px; object-fit:cover; border:2px solid var(--cream3); }

/* ════ PROGRESS BAR ════ */
.progress-bar { background:var(--cream3); border-radius:99px; height:7px; overflow:hidden; margin-top:6px; }
.progress-fill { height:100%; border-radius:99px; background:linear-gradient(90deg,var(--maroon),var(--gold)); transition:width .6s cubic-bezier(.16,1,.3,1); }

/* ════ APPROVAL ITEMS ════ */
.ap-item { display:flex; justify-content:space-between; align-items:center; padding:12px 0; border-bottom:1px solid var(--cream2); }
.ap-item:last-child { border-bottom:none; }
.ai-name { font-size:13px; font-weight:700; color:var(--dark); }
.ai-sub { font-size:11px; color:var(--muted); margin-top:2px; }

/* ════ ADVISORY ════ */
.adv-item { padding:14px 16px; background:var(--cream); border:1px solid var(--border); border-left:3px solid var(--maroon); border-radius:var(--radius-sm); margin-bottom:10px; }
.adv-meta { font-size:11px; color:var(--muted); margin-bottom:5px; }
.adv-text { font-size:13px; color:var(--slate); line-height:1.6; }

/* ════ LEGEND ROWS ════ */
.leg-row { display:flex; align-items:center; gap:14px; padding:12px 0; border-bottom:1px solid var(--cream2); }
.leg-row:last-child { border-bottom:none; }
.leg-row .lr-txt { font-size:13px; color:var(--slate); }

/* ════ CAMPUS MAP ════ */
#campus-map-wrap { position:relative; width:100%; border-radius:var(--radius-sm); overflow:hidden; background:#111; border:2px solid var(--border2); box-shadow:0 4px 20px var(--shadow2); }
#campus-svg { width:100%; height:auto; display:block; border-radius:var(--radius-sm); }
#zone-hotspots { position:absolute; inset:0; pointer-events:none; }

.zone-hs { position:absolute; border-radius:50%; display:flex; align-items:center; justify-content:center; font-family:'EB Garamond',serif; font-weight:700; font-size:16px; color:#fff; cursor:pointer; pointer-events:all; transition:transform .2s,box-shadow .2s; border:3px solid rgba(255,255,255,0.3); user-select:none; }
.zone-hs::after { content:''; position:absolute; inset:-7px; border-radius:50%; border:2px solid currentColor; opacity:.3; animation:ripple 2s ease-out infinite; }
@keyframes ripple { 0%{transform:scale(.82);opacity:.4;} 100%{transform:scale(1.35);opacity:0;} }
.zone-hs:hover { transform:scale(1.25); z-index:20; }
.zone-hs.green { background:radial-gradient(circle,#22c55e,#15803d); box-shadow:0 4px 22px rgba(26,140,78,0.6); }
.zone-hs.green::after { color:#22c55e; }
.zone-hs.yellow { background:radial-gradient(circle,#f59e0b,#b45309); box-shadow:0 4px 22px rgba(176,125,16,0.6); }
.zone-hs.yellow::after { color:#f59e0b; }
.zone-hs.red { background:radial-gradient(circle,#ef4444,#991b1b); box-shadow:0 4px 22px rgba(192,24,42,0.6); }
.zone-hs.red::after { color:#ef4444; }

/* ════ TOOLTIP ════ */
#zone-tooltip { position:fixed; display:none; background:var(--white); border:1px solid var(--border2); border-top:3px solid var(--maroon); border-radius:var(--radius); padding:20px 22px; min-width:275px; max-width:315px; box-shadow:0 20px 60px var(--shadow2); z-index:9998; pointer-events:none; font-family:'Nunito Sans',sans-serif; }
#zone-tooltip.show { display:block; animation:fadeIn .15s ease; }
@keyframes fadeIn { from{opacity:0;transform:translateY(6px);} to{opacity:1;transform:translateY(0);} }
.tt-hd { display:flex; align-items:center; gap:12px; margin-bottom:14px; }
.tt-badge { width:38px; height:38px; border-radius:50%; display:flex; align-items:center; justify-content:center; font-family:'EB Garamond',serif; font-weight:700; font-size:16px; color:#fff; flex-shrink:0; }
.tt-zname { font-family:'EB Garamond',serif; font-weight:700; font-size:15px; color:var(--dark); }
.tt-zhead { font-size:11px; color:var(--muted); margin-top:2px; }
.tt-sep { border:none; border-top:1px solid var(--cream3); margin:12px 0; }
.tt-row { display:flex; justify-content:space-between; align-items:center; margin-bottom:8px; font-size:12px; }
.tt-lbl { color:var(--muted); font-weight:500; }
.tt-val { font-weight:700; color:var(--dark); }
.tt-sbar { margin-top:12px; }
.tt-slbl { font-size:11px; color:var(--muted); margin-bottom:5px; font-weight:600; }
.tt-bbg { background:var(--cream3); border-radius:99px; height:7px; overflow:hidden; }
.tt-bfill { height:100%; border-radius:99px; transition:width .5s; }

/* ════ MAP LEGEND ════ */
.map-leg { display:flex; gap:22px; flex-wrap:wrap; margin-top:16px; }
.mleg-item { display:flex; align-items:center; gap:8px; font-size:12px; color:var(--muted); font-weight:600; }
.mleg-dot { width:11px; height:11px; border-radius:50%; flex-shrink:0; }

/* ════ SECTION DIVIDER ════ */
.gold-rule { height:2px; background:linear-gradient(90deg,var(--gold),transparent); margin:8px 0 20px; border-radius:99px; }

/* ════ TOAST ════ */
.toast { position:fixed; bottom:28px; right:28px; background:var(--maroon); color:var(--white); padding:14px 22px; border-radius:12px; font-size:13px; font-weight:600; z-index:99999; box-shadow:0 12px 40px rgba(140,27,47,0.4); transform:translateY(90px); opacity:0; transition:.35s cubic-bezier(.16,1,.3,1); max-width:340px; border-left:4px solid var(--gold); }
.toast.show { transform:translateY(0); opacity:1; }
</style>
</head>
<body>

<!-- ══════════════════════════════════════
     LOGIN
══════════════════════════════════════ -->
<div id="loginScreen" class="screen active">
  <div class="login-pattern"></div>
  <div class="login-outer">

    <!-- Left panel -->
    <div class="login-left">
      <!-- 👇 Background image layer — replace 'your-image.jpg' with your actual image filename -->
      <div class="bg-image-layer"></div>

      <div class="ll-logo" style="position:relative; z-index:1;">
<div class="ll-logo-icon"><img src="data:image/jpeg;base64," alt="GSFCU Logo" style="width:100%; height:100%; object-fit:contain; border-radius: inherit;"></div>
        <div class="ll-logo-text">
          <h1>GSFC University</h1>
          <p>Education Re-Envisioned</p>
        </div>
      </div>

      <div class="ll-body" style="position:relative; z-index:1;">
        <h2>6S Campus<br><span>Compliance</span><br>Monitor</h2>
        <p style="margin-top:16px;">A digital initiative to track and sustain the 6S methodology across all zones of the GSFC University campus.</p>
      </div>

      <div class="ll-footer" style="position:relative; z-index:1;">
        <p>Access levels</p>
        <div class="ll-pills">
          <span class="ll-pill">Student</span>
          <span class="ll-pill">Sub-Zonal Head</span>
          <span class="ll-pill">Zonal Head</span>
          <span class="ll-pill">Core Committee</span>
        </div>
      </div>
    </div>

    <!-- Right panel -->
    <div class="login-right">
      <div class="lr-title">Sign In</div>
      <p class="lr-sub">Enter your institutional credentials to access your dashboard</p>

      <div class="lf">
        <label>Login ID</label>
        <input type="text" id="loginId" placeholder="e.g. STU001 / ZH_Z1 / ADMIN_CHAIR" autocomplete="off">
      </div>
      <div class="lf">
        <label>Password</label>
        <input type="password" id="loginPass" placeholder="Enter your password">
      </div>
      <p class="login-err" id="loginErr"></p>
      <button class="btn-login" onclick="doLogin()">Sign In to Dashboard →</button>

     
    </div>
  </div>
</div>


<!-- ══════════════════════════════════════
     LEVEL 1 — STUDENT
══════════════════════════════════════ -->
<div id="studentScreen" class="screen">
  <div class="app-layout">
    <aside class="sidebar">
      <div class="sb-header">
        <div class="sb-logo-row">
<div class="sb-icon"><img src="data:image/jpeg;base64," alt="GSFCU Logo" style="width:100%; height:100%; object-fit:contain; border-radius: inherit;"></div>
          <div class="sb-brand"><h1>GSFC University</h1><p>6S Monitor</p></div>
        </div>
        <div class="sb-divider"></div>
        <div class="sb-section-label">Student Portal</div>
        <div class="sb-nav active"><span class="ni"><i class="fa-solid fa-envelope-open-text"></i></span>My Concerns</div>
        <div class="sb-nav"><span class="ni"><i class="fa-solid fa-chart-line"></i></span>My Activity</div>
      </div>
      <div class="sb-bottom">
        <div class="sb-user">
          <div class="sb-avatar"><i class="fa-solid fa-graduation-cap"></i></div>
          <div><div class="sb-uname" id="stu-uname">Student</div><div class="sb-urole">Level 1 — Student</div></div>
        </div>
        <button class="btn-logout" onclick="logout()">← Sign Out</button>
      </div>
    </aside>

    <div class="main-area">
      <div class="top-bar">
        <div class="tb-breadcrumb">GSFCU 6S Monitor &rsaquo; <strong>My Concerns</strong></div>
        <div class="tb-right"><span class="tb-badge tb-l1">Level 1 — Student</span></div>
      </div>
      <div class="pg">
        <div class="pg-header">
          <div class="pg-eyebrow"><div class="edot"></div>Student Portal</div>
          <h2>Concern Box</h2>
          <p>Your voice matters. Share any 6S compliance concern you notice on campus — together we build a safer, cleaner, and more organized environment.Your concern will be reviewed by the Zonal Head within 7 days.</p>
        </div>
        <div class="gold-rule"></div>

        <div class="grid-3" style="margin-bottom:24px;">
          <div class="sc sc-maroon"><div class="sc-top"><div class="sc-ico"><i class="fa-solid fa-clipboard-list"></i></div></div><div class="sc-num" id="stu-total">0</div><div class="sc-lbl">All concerns you've raised so far</div></div>
          <div class="sc sc-green"><div class="sc-top"><div class="sc-ico"><i class="fa-solid fa-circle-check"></i></div></div><div class="sc-num" id="stu-res">0</div><div class="sc-lbl">Concerns successfully addressed</div></div>
          <div class="sc sc-gold"><div class="sc-top"><div class="sc-ico"><i class="fa-solid fa-hourglass-half"></i></div></div><div class="sc-num" id="stu-pen">0</div><div class="sc-lbl">Pending Review</div></div>
        </div>

        <div class="grid-2">
          <div class="card">
            <div class="card-hdr"><div class="card-title"><div class="card-icon ci-maroon"><i class="fa-solid fa-pen-to-square"></i></div>New Concern</div></div>
            <div class="fg"><label>Zone *</label>
              <select id="stu-zone"><option value="">— Select Zone —</option><option value="1">Zone 1 – Anviksha</option><option value="2">Zone 2 – School of Technology</option><option value="3">Zone 3 – Common Amenities</option><option value="4">Zone 4 – Kasturba Bhavan</option><option value="5">Zone 5 – Vikram Sarabhai Bhavan</option><option value="6">Zone 6 – Swami Vivekananda Bhavan</option><option value="7">Zone 7 – FirePlex</option><option value="8">Zone 8 – School of Science / Management</option></select>
            </div>
            <div class="fg"><label>Concern Description *</label><textarea id="stu-desc" placeholder="What did you observe? Describe the location, the nature of the issue (cleanliness, labeling, safety, organization, etc.), and anything else that would help us address it effectively..."></textarea></div>
            <div class="fg"><label>Attach Photo</label>
              <div class="upload-zone" onclick="triggerUpload()"><div class="up-emoji"><i class="fa-solid fa-camera"></i></div><div class="up-text">Click to upload or drag &amp; drop</div><div class="up-hint">JPEG, PNG, HEIC — max 10MB</div></div>
              <input type="file" id="stu-photo" accept="image/*" style="display:none" onchange="previewPhoto(event)">
              <div class="photo-preview" id="photo-preview-area"></div>
            </div>
            <button class="btn-p" onclick="submitComplaint()">Submit your concern→</button>
          </div>
          <div class="card">
            <div class="card-hdr"><div class="card-title"><div class="card-icon ci-maroon"><i class="fa-solid fa-inbox"></i></div>My Concerns</div></div>
            <div id="stu-complaints-list"><p style="color:var(--muted);font-size:13px;padding:12px 0;"><textarea id="stu-desc" placeholder="You haven't raised any concerns yet. If you notice something that needs attention, don't hesitate — speaking up helps everyone."></textarea></p></div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>


<!-- ══════════════════════════════════════
     LEVEL 2 — SUB-ZONAL HEAD
══════════════════════════════════════ -->
