            <table class="tbl"><thead><tr><th>Zone</th><th>Floor / Area</th><th>Head</th><th>Status</th></tr></thead><tbody id="adm-szh-table"></tbody></table>
          </div>
          <div>
            <div class="card" style="margin-bottom:20px;">
              <div class="card-hdr"><div class="card-title"><div class="card-icon ci-maroon"><i class="fa-solid fa-tower-broadcast"></i></div>Publish Global Advisory</div></div>
              <div class="fg"><label>Target Zone</label><select id="adm-advisory-zone"><option value="all">All Zones</option><option value="1">Zone 1 – Anviksha</option><option value="2">Zone 2 – School of Technology</option><option value="3">Zone 3 – Common Amenities</option><option value="4">Zone 4 – Kasturba Bhavan</option><option value="5">Zone 5 – Vikram Sarabhai Bhavan</option><option value="6">Zone 6 – Swami Vivekananda Bhavan</option><option value="7">Zone 7 – FirePlex</option><option value="8">Zone 8 – School of Science / Management</option></select></div>
              <div class="fg"><label>Advisory Notice</label><textarea id="adm-advisory-text" placeholder="Write a compliance advisory or official notice…"></textarea></div>
