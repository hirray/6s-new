<!-- TOOLTIP -->
<div id="zone-tooltip">
  <div class="tt-hd">
    <div class="tt-badge" id="tt-num"></div>
    <div><div class="tt-zname" id="tt-name"></div><div class="tt-zhead" id="tt-head"></div></div>
  </div>
  <hr class="tt-sep">
  <div class="tt-row"><span class="tt-lbl">Overall Status</span><span class="tt-val" id="tt-status"></span></div>
  <div class="tt-row"><span class="tt-lbl">Checklist</span><span class="tt-val" id="tt-checklist"></span></div>
  <div class="tt-row"><span class="tt-lbl">Last Submission</span><span class="tt-val" id="tt-last"></span></div>
  <div class="tt-row"><span class="tt-lbl">Open Concerns</span><span class="tt-val" id="tt-complaints"></span></div>
  <div class="tt-row"><span class="tt-lbl">Zonal Review</span><span class="tt-val" id="tt-review"></span></div>
  <div class="tt-sbar">
    <div class="tt-slbl" id="tt-slbl">Compliance Score</div>
    <div class="tt-bbg"><div class="tt-bfill" id="tt-bar"></div></div>
  </div>
</div>

<div class="toast" id="toast"></div>

<script>
/* ═══════ DATA ═══════ */
const ZONES=[{id:1,area:"Anviksha",head:"Dr. Devjani Banerjee",loginId:"ZH_Z1"},{id:2,area:"School of Technology",head:"Dr. Sanjukta B. Goswami",loginId:"ZH_Z2"},{id:3,area:"Common Amenities",head:"Mr. Naren Acharya",loginId:"ZH_Z3"},{id:4,area:"Kasturba Bhavan",head:"Dr. Abha Kalaiya",loginId:"ZH_Z4"},{id:5,area:"Vikram Sarabhai Bhavan",head:"Dr. Mayank Sharma",loginId:"ZH_Z5"},{id:6,area:"Swami Vivekananda Bhavan",head:"Dr. Akhilesh Prajapati",loginId:"ZH_Z6"},{id:7,area:"FirePlex",head:"Mr. A. Srikrishnan",loginId:"ZH_Z7"},{id:8,area:"School of Science / Management",head:"Prof. Ranjitha Banerjee",loginId:"ZH_Z8"}];
const SZH=[{id:"SZH_F1",name:"Mr. Rajesh Patel",floor:"Ground Floor / Block A",zone:1},{id:"SZH_F2",name:"Ms. Priya Sharma",floor:"First Floor / Block B",zone:2},{id:"SZH_F3",name:"Mr. Anil Verma",floor:"Second Floor / Block C",zone:3},{id:"SZH_F4",name:"Ms. Kavita Joshi",floor:"Ground Floor / Block D",zone:4},{id:"SZH_F5",name:"Mr. Suresh Mehta",floor:"First Floor / Block E",zone:5},{id:"SZH_F6",name:"Ms. Anita Singh",floor:"Second Floor / Block F",zone:6},{id:"SZH_F7",name:"Mr. Deepak Kumar",floor:"Ground Floor / FirePlex",zone:7},{id:"SZH_F8",name:"Ms. Ritu Gupta",floor:"First Floor / SoS",zone:8}];
const ADMINS=[{id:"ADMIN_CHAIR",name:"Director Admin",title:"Chairman"},{id:"ADMIN_PROVOST",name:"Provost",title:"Provost"},{id:"ADMIN_DEAN",name:"Dean",title:"Dean"},{id:"ADMIN_CONV",name:"Convener",title:"Convener"}];
const CL_TASKS=["Sort (Seiri): Remove unnecessary items from the area","Set in Order (Seiton): Proper labeling and placement of items","Shine (Seiso): Clean floors, surfaces, and equipment","Standardize (Seiketsu): Check standardization boards & visual aids","Sustain (Shitsuke): Verify compliance with previous day's standards","Safety (Anzen): Fire exits, hazards, and safety signage check","Waste segregation bins properly placed and labeled","Notice boards — outdated notices removed"];
const ZST=["green","green","green","yellow","green","red","yellow","green"];
const ZDET=[{checklist:"8/8",lastSub:"Today, 09:14 AM",complaints:1,review:"2 days ago",score:98},{checklist:"7/8",lastSub:"Today, 10:30 AM",complaints:2,review:"1 day ago",score:92},{checklist:"8/8",lastSub:"Today, 08:55 AM",complaints:0,review:"3 days ago",score:100},{checklist:"6/8",lastSub:"Yesterday, 11:40 AM",complaints:3,review:"8 days ago",score:72},{checklist:"8/8",lastSub:"Today, 09:00 AM",complaints:1,review:"4 days ago",score:95},{checklist:"4/8",lastSub:"2 days ago",complaints:5,review:"Not reviewed (10d)",score:45},{checklist:"5/8",lastSub:"Yesterday, 02:10 PM",complaints:2,review:"6 days ago",score:68},{checklist:"8/8",lastSub:"Today, 08:45 AM",complaints:0,review:"Today",score:100}];
const ZPOS=[{id:1,cx:.629,cy:.119},{id:2,cx:.515,cy:.250},{id:3,cx:.601,cy:.415},{id:4,cx:.328,cy:.329},{id:5,cx:.302,cy:.453},{id:6,cx:.421,cy:.119},{id:7,cx:.119,cy:.266},{id:8,cx:.708,cy:.692}];

let db={complaints:[],checklistSubmissions:[],remarks:[],advisories:[]};
let currentUser=null; const clState={};

/* ═══════ AUTH ═══════ */
function doLogin(){
  const id=document.getElementById('loginId').value.trim().toUpperCase();
  const pass=document.getElementById('loginPass').value.trim();
  document.getElementById('loginErr').textContent='';
  if(!id||!pass){document.getElementById('loginErr').textContent='Please enter your Login ID and Password.';return;}
  if(pass!=='1234'){document.getElementById('loginErr').textContent='Incorrect password. Please try again.';return;}
  if(id==='STU001'||id.startsWith('STU')){currentUser={id,name:'Student User',level:1};loadStu();}
  else if(SZH.find(s=>s.id===id)){const s=SZH.find(s=>s.id===id);currentUser={id,name:s.name,level:2,data:s};loadSZH();}
  else if(ZONES.find(z=>z.loginId===id)){const z=ZONES.find(z=>z.loginId===id);currentUser={id,name:z.head,level:3,data:z};loadZH();}
  else if(ADMINS.find(a=>a.id===id)){const a=ADMINS.find(a=>a.id===id);currentUser={id,name:a.name,level:4,data:a};loadAdm();}
  else{document.getElementById('loginErr').textContent='Login ID not recognised. Please check your credentials.';return;}
  switchScreen(currentUser.level);
}
function switchScreen(l){document.querySelectorAll('.screen').forEach(s=>s.classList.remove('active'));const m={1:'studentScreen',2:'subzonalScreen',3:'zonalScreen',4:'adminScreen'};document.getElementById(m[l]).classList.add('active');}
function logout(){currentUser=null;document.querySelectorAll('.screen').forEach(s=>s.classList.remove('active'));document.getElementById('loginScreen').classList.add('active');document.getElementById('loginId').value='';document.getElementById('loginPass').value='';}

/* ═══════ LEVEL 1: STUDENT ═══════ */
function loadStu(){document.getElementById('stu-uname').textContent=currentUser.name;refreshStu();}
function triggerUpload(){document.getElementById('stu-photo').click();}
function previewPhoto(e){const a=document.getElementById('photo-preview-area');a.innerHTML='';const f=e.target.files[0];if(!f)return;const r=new FileReader();r.onload=ev=>{const i=document.createElement('img');i.src=ev.target.result;i.className='photo-thumb';a.appendChild(i);};r.readAsDataURL(f);}
function submitComplaint(){
  const zone=document.getElementById('stu-zone').value;const desc=document.getElementById('stu-desc').value.trim();
  if(!zone){showToast('Please select a zone.');return;}if(!desc){showToast('Please describe the issue.');return;}
  const c={id:'C'+Date.now(),studentId:currentUser.id,zone:parseInt(zone),zoneName:ZONES[parseInt(zone)-1].area,desc,hasPhoto:!!document.getElementById('stu-photo').files[0],ts:new Date(),status:'Pending'};
  db.complaints.unshift(c);document.getElementById('stu-zone').value='';document.getElementById('stu-desc').value='';document.getElementById('stu-photo').value='';document.getElementById('photo-preview-area').innerHTML='';
  refreshStu();showToast('Complaint submitted successfully!');
}
function refreshStu(){
  const mine=db.complaints.filter(c=>c.studentId===currentUser.id);
  document.getElementById('stu-total').textContent=mine.length;
  document.getElementById('stu-res').textContent=mine.filter(c=>c.status==='Resolved').length;
  document.getElementById('stu-pen').textContent=mine.filter(c=>c.status==='Pending').length;
  const el=document.getElementById('stu-complaints-list');
  if(!mine.length){el.innerHTML='<p style="color:var(--muted);font-size:13px;padding:12px 0;">No complaints submitted yet.</p>';return;}
  el.innerHTML=mine.map(c=>`<div class="ci"><div class="ci-top"><span class="ci-ztag">Zone ${c.zone} — ${c.zoneName}</span>${bdg(c.status==='Resolved'?'g':'y',c.status)}</div><div class="ci-desc">${c.desc}</div><div class="ci-meta">${c.hasPhoto?'[Photo] Photo attached · ':''}${fmt(c.ts)} · ${c.id}</div></div>`).join('');
}

/* ═══════ LEVEL 2: SUB-ZONAL ═══════ */
function loadSZH(){
  const s=currentUser.data;
  document.getElementById('szh-uname').textContent=currentUser.name;
  document.getElementById('szh-urole').textContent=`Zone ${s.zone} · ${s.floor}`;
  document.getElementById('szh-sub').textContent=`${s.floor} — Zone ${s.zone} (${ZONES[s.zone-1].area})`;
  document.getElementById('checklist-items').innerHTML=CL_TASKS.map((t,i)=>`<div class="cl-item" id="cli${i}" onclick="togCL(${i})"><input type="checkbox" id="cl${i}" onchange="clChg(${i})" onclick="event.stopPropagation()"><label for="cl${i}">${t}</label><span class="cl-time" id="clt${i}"></span></div>`).join('');
  const sts=['green','green','yellow','green','green','red','green'];const today=new Date();
  document.getElementById('szh-history').innerHTML=sts.map((st,i)=>{const d=new Date(today);d.setDate(d.getDate()-i-1);const t=st==='green'?'09:'+String(Math.floor(Math.random()*30)+10).padStart(2,'0')+' AM':'—';return`<tr><td>${d.toLocaleDateString('en-IN',{day:'2-digit',month:'short'})}</td><td style="color:var(--muted);">${t}</td><td>${bdg(st==='green'?'g':st==='yellow'?'y':'r',st.charAt(0).toUpperCase()+st.slice(1))}</td></tr>`;}).join('');
  const zc=db.complaints.filter(c=>c.zone===s.zone);
  document.getElementById('szh-floor-complaints').innerHTML=zc.length?zc.map(c=>`<div class="ci"><div class="ci-desc">${c.desc}</div><div class="ci-meta">${fmt(c.ts)}</div></div>`).join(''):'<p style="color:var(--muted);font-size:13px;">No complaints in your zone yet.</p>';
  updProg();updTodaySt();
}
function togCL(i){const cb=document.getElementById('cl'+i);cb.checked=!cb.checked;clChg(i);}
function clChg(i){const w=document.getElementById('cli'+i);if(document.getElementById('cl'+i).checked){document.getElementById('clt'+i).textContent=new Date().toLocaleTimeString('en-IN',{hour:'2-digit',minute:'2-digit'});clState[i]=new Date();w.classList.add('checked');}else{document.getElementById('clt'+i).textContent='';delete clState[i];w.classList.remove('checked');}updProg();}
function updProg(){const done=Object.keys(clState).length;document.getElementById('szh-progress-txt').textContent=`${done} / ${CL_TASKS.length} tasks done`;document.getElementById('progress-fill').style.width=Math.round(done/CL_TASKS.length*100)+'%';}
function updTodaySt(){const b=document.getElementById('szh-status-badge');const sub=db.checklistSubmissions.find(s=>s.userId===currentUser.id&&sameDay(s.ts,new Date()));b.innerHTML=sub?bdg('g','Submitted Today'):bdg('r','Not Yet Submitted');}
function submitChecklist(){const done=Object.keys(clState).length;if(done<CL_TASKS.length&&!confirm(`Only ${done}/${CL_TASKS.length} tasks done. Submit anyway?`))return;db.checklistSubmissions.push({userId:currentUser.id,ts:new Date(),tasks:done});showToast('Checklist submitted! Status: Green');updTodaySt();}

/* ═══════ LEVEL 3: ZONAL HEAD ═══════ */
function loadZH(){
  const z=currentUser.data;
  document.getElementById('zh-uname').textContent=currentUser.name;
  document.getElementById('zh-urole').textContent=`Zone ${z.id} — ${z.area}`;
  document.getElementById('zh-zone-title').textContent=`Zone ${z.id} — ${z.area}`;
  document.getElementById('zh-zone-title-bar').textContent=`Zone ${z.id} — ${z.area}`;
  document.getElementById('zh-zone-sub').textContent=`Zonal Head: ${z.head}`;
  const mySZHs=SZH.filter(s=>s.zone===z.id);
  document.getElementById('zh-remark-target').innerHTML='<option value="">— Select —</option>'+mySZHs.map(s=>`<option value="${s.id}">${s.name} (${s.floor})</option>`).join('');
  const sts=['green','yellow','green'];
  document.getElementById('zh-sublogs').innerHTML=mySZHs.map((s,i)=>{const st=sts[i%sts.length];const t=new Date();t.setHours(9,Math.floor(Math.random()*50),0);return`<tr><td style="color:var(--dark);font-weight:600;">${s.floor}</td><td>${s.name}</td><td style="color:var(--muted);">${t.toLocaleTimeString('en-IN',{hour:'2-digit',minute:'2-digit'})}</td><td>${bdg(st==='green'?'g':st==='yellow'?'y':'r',st.charAt(0).toUpperCase()+st.slice(1))}</td><td><button class="btn-gold" onclick="approveLog('${s.id}')">Approve</button></td></tr>`;}).join('');
  const zc=db.complaints.filter(c=>c.zone===z.id);
  document.getElementById('zh-complaints').innerHTML=zc.length?zc.map(c=>`<div class="ci"><div class="ci-top"><span class="ci-ztag">Zone ${c.zone}</span></div><div class="ci-desc">${c.desc}</div><div class="ci-meta">${fmt(c.ts)}</div></div>`).join(''):'<p style="color:var(--muted);font-size:13px;">No concerns raised in this zone.</p>';
  document.getElementById('zh-approval-list').innerHTML=mySZHs.map((s,i)=>{const days=[1,5,9][i%3];const st=days<=7?'g':days<=10?'y':'r';return`<div class="ap-item"><div><div class="ai-name">${s.name}</div><div class="ai-sub">Reviewed ${days} day(s) ago</div></div>${bdg(st,days<=7?'Green':days<=10?'Yellow':'Red')}</div>`;}).join('');
}
function approveLog(id){showToast('Log approved for '+SZH.find(s=>s.id===id)?.name);}
function addRemark(){const target=document.getElementById('zh-remark-target').value;const text=document.getElementById('zh-remark-text').value.trim();if(!target||!text){showToast('Please select a head and write a remark.');return;}db.remarks.push({from:currentUser.id,to:target,text,ts:new Date()});document.getElementById('zh-remark-text').value='';showToast('Remark submitted successfully!');}

/* ═══════ LEVEL 4: ADMIN ═══════ */
function loadAdm(){
  const adm=currentUser.data;
  document.getElementById('admin-uname').textContent=adm.name+' ('+adm.title+')';
  document.getElementById('adm-green').textContent=ZST.filter(s=>s==='green').length;
  document.getElementById('adm-yellow').textContent=ZST.filter(s=>s==='yellow').length;
  document.getElementById('adm-red').textContent=ZST.filter(s=>s==='red').length;
  const pills=document.getElementById('sidebar-zone-pills');
  pills.innerHTML=ZONES.map((z,i)=>{const st=ZST[i];const col={green:'#22c55e',yellow:'#f59e0b',red:'#ef4444'}[st];return`<div class="sb-zone-pill sb-zone-pill-btn" onclick="adminViewZone(${z.id})" title="View Zone ${z.id} Dashboard" style="cursor:pointer;transition:.15s;"><div class="zpd" style="background:${col};box-shadow:0 0 6px ${col};"></div><span>Z${z.id} — ${z.area.split(' ')[0]}</span><span style="margin-left:auto;font-size:9px;opacity:.45;">›</span></div>`;}).join('');
  const szSts=['green','green','yellow','green','green','red','yellow','green'];
  document.getElementById('adm-szh-table').innerHTML=SZH.map((s,i)=>{const z=ZONES[s.zone-1];const st=szSts[i];return`<tr><td style="color:var(--maroon);font-weight:700;">Z${s.zone}</td><td style="color:var(--dark);font-weight:600;">${s.floor}</td><td>${s.name}</td><td>${bdg(st==='green'?'g':st==='yellow'?'y':'r',st.charAt(0).toUpperCase()+st.slice(1))}</td></tr>`;}).join('');
  refreshAdv();setTimeout(buildMap,120);
}
function sendAdvisory(){const zone=document.getElementById('adm-advisory-zone').value;const text=document.getElementById('adm-advisory-text').value.trim();if(!text){showToast('Please write an advisory.');return;}db.advisories.unshift({zone,text,by:currentUser.data.title,ts:new Date()});document.getElementById('adm-advisory-text').value='';refreshAdv();showToast('Advisory published successfully!');}
function refreshAdv(){const el=document.getElementById('adm-advisories');if(!db.advisories.length){el.innerHTML='<p style="color:var(--muted);font-size:13px;">No advisories published yet.</p>';return;}el.innerHTML=db.advisories.map(a=>`<div class="adv-item"><div class="adv-meta">${a.zone==='all'?'All Zones':'Zone '+a.zone} · ${fmt(a.ts)} · ${a.by}</div><div class="adv-text">${a.text}</div></div>`).join('');}

/* ═══════ CAMPUS MAP ═══════ */
function buildMap(){
  const wrap=document.getElementById('campus-map-wrap');const svg=document.getElementById('campus-svg');const hc=document.getElementById('zone-hotspots');
  hc.innerHTML='';hc.style.cssText='position:absolute;inset:0;pointer-events:none;';
  const sr=svg.getBoundingClientRect();const wr=wrap.getBoundingClientRect();
  const ox=sr.left-wr.left,oy=sr.top-wr.top,sw=sr.width,sh=sr.height,R=24;
  ZPOS.forEach((zp,idx)=>{
    const zone=ZONES[idx],status=ZST[idx],detail=ZDET[idx];
    const cx=ox+zp.cx*sw,cy=oy+zp.cy*sh;
    const dot=document.createElement('div');
    dot.className=`zone-hs ${status}`;dot.textContent=zp.id;
    dot.style.cssText=`left:${cx-R}px;top:${cy-R}px;width:${R*2}px;height:${R*2}px;pointer-events:all;`;
    dot.addEventListener('mouseenter',e=>showTT(e,zone,status,detail));
    dot.addEventListener('mousemove',moveTT);dot.addEventListener('mouseleave',hideTT);
    hc.appendChild(dot);
  });
}
function adminViewZone(zoneId){
  var zone=ZONES.find(function(z){return z.id===zoneId;});
  var status=ZST[zoneId-1];
  var detail=ZDET[zoneId-1];
  var mySZHs=SZH.filter(function(s){return s.zone===zoneId;});
  var col={green:'#1A8C4E',yellow:'#B07D10',red:'#C0182A'}[status];
  var lbl={green:'Green — On Time',yellow:'Yellow — Delayed',red:'Red — Overdue'}[status];

  var existing=document.getElementById('adminZoneModal');
  if(existing)existing.remove();

  var sts=['green','yellow','green'];
  var szhRows=mySZHs.map(function(s,i){
    var st=sts[i%sts.length];
    var stKey=st==='green'?'g':st==='yellow'?'y':'r';
    var stLabel=st.charAt(0).toUpperCase()+st.slice(1);
    return '<tr><td style="color:var(--dark);font-weight:600;">'+s.floor+'</td><td style="color:var(--muted);">'+s.name+'</td><td>'+bdg(stKey,stLabel)+'</td></tr>';
  }).join('');

  var statusBadgeHtml=bdg(status==='green'?'g':status==='yellow'?'y':'r',lbl);
  var scoreBarColor='linear-gradient(90deg,'+col+',#C4933F)';

  var modal=document.createElement('div');
  modal.id='adminZoneModal';
  modal.setAttribute('style','position:fixed;inset:0;z-index:9000;display:flex;align-items:center;justify-content:center;background:rgba(28,10,14,0.55);backdrop-filter:blur(4px);');

  modal.innerHTML=
    '<div style="background:#fff;border-radius:20px;padding:0;width:680px;max-width:96vw;max-height:88vh;overflow-y:auto;box-shadow:0 32px 80px rgba(0,0,0,0.3);border:1px solid rgba(140,27,47,0.2);">'+
      '<div style="background:linear-gradient(135deg,#4D0D19,#6E1424);padding:24px 28px 20px;border-radius:20px 20px 0 0;display:flex;justify-content:space-between;align-items:flex-start;">'+
        '<div>'+
          '<div style="font-size:10px;font-weight:800;letter-spacing:1px;text-transform:uppercase;color:#E2B96A;margin-bottom:4px;">Zone '+zoneId+' Dashboard Preview</div>'+
          '<div style="font-family:EB Garamond,serif;font-size:24px;font-weight:700;color:#fff;">'+zone.area+'</div>'+
          '<div style="font-size:12px;color:rgba(255,255,255,0.55);margin-top:3px;">Zonal Head: '+zone.head+'</div>'+
        '</div>'+
        '<button onclick="document.getElementById(\'adminZoneModal\').remove()" style="background:rgba(255,255,255,0.12);border:1px solid rgba(255,255,255,0.2);border-radius:8px;color:#fff;padding:8px 14px;cursor:pointer;font-size:13px;font-weight:600;">&#x2715; Close</button>'+
      '</div>'+
      '<div style="background:#FBF7F2;padding:16px 28px;border-bottom:1px solid rgba(140,27,47,0.12);display:flex;align-items:center;gap:16px;">'+
        '<span style="font-size:12px;color:#7A4050;font-weight:600;">OVERALL STATUS</span>'+
        statusBadgeHtml+
        '<div style="margin-left:auto;font-size:12px;color:#7A4050;">Compliance Score: <strong style="color:'+col+';font-size:14px;">'+detail.score+'%</strong></div>'+
      '</div>'+
      '<div style="display:grid;grid-template-columns:repeat(3,1fr);gap:0;border-bottom:1px solid rgba(140,27,47,0.12);">'+
        '<div style="padding:18px 24px;border-right:1px solid rgba(140,27,47,0.12);text-align:center;">'+
          '<div style="font-family:EB Garamond,serif;font-size:30px;font-weight:800;color:#8C1B2F;">'+detail.checklist+'</div>'+
          '<div style="font-size:11px;color:#7A4050;font-weight:600;">Checklist Tasks</div>'+
        '</div>'+
        '<div style="padding:18px 24px;border-right:1px solid rgba(140,27,47,0.12);text-align:center;">'+
          '<div style="font-family:EB Garamond,serif;font-size:30px;font-weight:800;color:#8C1B2F;">'+detail.complaints+'</div>'+
          '<div style="font-size:11px;color:#7A4050;font-weight:600;">Open Concerns</div>'+
        '</div>'+
        '<div style="padding:18px 24px;text-align:center;">'+
          '<div style="font-size:13px;font-weight:700;color:#1C0A0E;margin-top:6px;">'+detail.lastSub+'</div>'+
          '<div style="font-size:11px;color:#7A4050;font-weight:600;">Last Submission</div>'+
        '</div>'+
      '</div>'+
      '<div style="padding:16px 28px;border-bottom:1px solid rgba(140,27,47,0.12);">'+
        '<div style="font-size:11px;color:#7A4050;font-weight:700;text-transform:uppercase;letter-spacing:.5px;margin-bottom:8px;">Compliance Progress</div>'+
        '<div style="background:#EDE4D6;border-radius:99px;height:10px;overflow:hidden;">'+
          '<div style="height:100%;width:'+detail.score+'%;background:'+scoreBarColor+';border-radius:99px;"></div>'+
        '</div>'+
      '</div>'+
      '<div style="padding:20px 28px;">'+
        '<div style="font-family:EB Garamond,serif;font-size:16px;font-weight:700;color:#8C1B2F;margin-bottom:12px;">Sub-Zonal Head Logs</div>'+
        '<table class="tbl" style="width:100%;"><thead><tr><th>Floor / Area</th><th>Head</th><th>Status</th></tr></thead><tbody>'+szhRows+'</tbody></table>'+
      '</div>'+
      '<div style="padding:0 28px 20px;">'+
        '<div style="padding:14px 16px;background:#FBF7F2;border-radius:10px;border-left:3px solid #C4933F;font-size:13px;color:#4A2030;">'+
          '<strong style="color:#8C1B2F;">Zonal Review:</strong> '+detail.review+
        '</div>'+
      '</div>'+
    '</div>';

  modal.addEventListener('click',function(e){if(e.target===modal)modal.remove();});
  document.body.appendChild(modal);
}

function showTT(e,zone,status,detail){
  const tt=document.getElementById('zone-tooltip');
  const col={green:'#1A8C4E',yellow:'#B07D10',red:'#C0182A'}[status];
  const lbl={green:'Green — On Time',yellow:'Yellow — Delayed',red:'Red — Overdue'}[status];
  document.getElementById('tt-num').textContent=zone.id;document.getElementById('tt-num').style.background=status==='green'?'#1A8C4E':status==='yellow'?'#B07D10':'#C0182A';
  document.getElementById('tt-name').textContent=zone.area;document.getElementById('tt-head').textContent=zone.head;
  document.getElementById('tt-status').textContent=lbl;document.getElementById('tt-status').style.color=col;
  document.getElementById('tt-checklist').textContent=detail.checklist+' tasks done';
  document.getElementById('tt-last').textContent=detail.lastSub;
  document.getElementById('tt-complaints').textContent=detail.complaints+(detail.complaints===1?' complaint':' complaints');
  document.getElementById('tt-review').textContent=detail.review;
  const bar=document.getElementById('tt-bar');bar.style.width=detail.score+'%';bar.style.background=`linear-gradient(90deg,${col},${status==='green'?'#C4933F':col})`;
  document.getElementById('tt-slbl').textContent=`Compliance Score: ${detail.score}%`;
  tt.classList.add('show');moveTT(e);
}
function moveTT(e){const tt=document.getElementById('zone-tooltip');const m=18;let x=e.clientX+m,y=e.clientY-tt.offsetHeight/2;if(x+tt.offsetWidth>window.innerWidth-10)x=e.clientX-tt.offsetWidth-m;if(y<10)y=10;if(y+tt.offsetHeight>window.innerHeight-10)y=window.innerHeight-tt.offsetHeight-10;tt.style.left=x+'px';tt.style.top=y+'px';}
function hideTT(){document.getElementById('zone-tooltip').classList.remove('show');}
window.addEventListener('resize',()=>{if(currentUser&&currentUser.level===4)buildMap();});

/* ═══════ UTILS ═══════ */
function bdg(t,label){const m={g:'bdg-g',y:'bdg-y',r:'bdg-r'};const d={g:'sdg',y:'sdy',r:'sdr'};return`<span class="bdg ${m[t]}"><span class="sdot ${d[t]}"></span>${label}</span>`;}
function fmt(d){if(!d)return'—';return new Date(d).toLocaleString('en-IN',{day:'2-digit',month:'short',year:'numeric',hour:'2-digit',minute:'2-digit'});}
function sameDay(d1,d2){return d1.getDate()===d2.getDate()&&d1.getMonth()===d2.getMonth()&&d1.getFullYear()===d2.getFullYear();}
function showToast(msg){const t=document.getElementById('toast');t.textContent=msg;t.classList.add('show');setTimeout(()=>t.classList.remove('show'),3400);}

document.getElementById('loginPass').addEventListener('keydown',e=>{if(e.key==='Enter')doLogin();});
document.getElementById('loginId').addEventListener('keydown',e=>{if(e.key==='Enter')doLogin();});

/* seed demo data */
db.complaints.push(
  {id:'C001',studentId:'STU999',zone:2,zoneName:'School of Technology',desc:'Floor near lab 204 is wet and slippery — no warning sign placed.',hasPhoto:true,ts:new Date(Date.now()-3600000*2),status:'Pending'},
  {id:'C002',studentId:'STU999',zone:5,zoneName:'Vikram Sarabhai Bhavan',desc:'Old notices from last semester still on the board.',hasPhoto:false,ts:new Date(Date.now()-3600000*26),status:'Resolved'},
  {id:'C003',studentId:'STU999',zone:6,zoneName:'Swami Vivekananda Bhavan',desc:'Dustbin overflowing near corridor B entrance.',hasPhoto:true,ts:new Date(Date.now()-3600000*5),status:'Pending'}
);
</script>
</body>
